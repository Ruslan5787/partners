<Window x:Class="Plants_App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Plants_App"
        mc:Ignorable="d"
        Background="#A0C878"
        FontFamily="Segoe UI"
        Title="Список партнеров" Height="500" Width="1000" FontSize="20" WindowStartupLocation="CenterScreen">
    <Grid>
        <ScrollViewer Margin="40 20 40 0"  Background="#DDEB9D">
                        <Border BorderBrush="DarkGray" BorderThickness="1" Background="Transparent">
                <ItemsControl x:Name="receiptsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="15" Background="#FAF6E9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border BorderBrush="Gray" BorderThickness="1" Padding="20 10">
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" MouseLeftButtonDown="StackPanelMouseLeftButtonDown">
                                        <DockPanel LastChildFill="False">

                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                                                <TextBlock Text="{Binding PartnerType}" />
                                                <TextBlock Text=" | " />
                                                <TextBlock Text="{Binding PartnerName}" />
                                            </StackPanel>
                                            <StackPanel Margin="0 0 40 0" Orientation="Horizontal"  DockPanel.Dock="Right">
                                                <TextBlock Text="{Binding Discount}" />
                                                <TextBlock Text="%" />
                                            </StackPanel>
                                            
                                        </DockPanel>
                                            <TextBlock Text="{Binding Director}" />
                                        <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="+7 " />
                                                <TextBlock Text="{Binding PartnerPhone}" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Рейтинг: " />
                                                <TextBlock Text="{Binding Reyting}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                        </Border>
            </ScrollViewer>
    </Grid>
</Window>
